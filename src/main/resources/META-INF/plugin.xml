<idea-plugin>
  <id>de.hendrikfrahmann.giteaplugin</id>
  <name>Gitea Pull Requests &amp; Actions</name>
  <vendor url="https://github.com/hfrahmann/Gitea-Pull-Requests-Actions">Hendrik Frahmann</vendor>
  <category>Version Controls</category>

  <!-- description and change-notes are filled in from README.md / CHANGELOG.md by the build -->

  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>
  <!-- Gitea issues as tasks; everything touching com.intellij.tasks is in the tasks/ package -->
  <depends optional="true" config-file="gitea-tasks.xml">com.intellij.tasks</depends>
  <depends optional="true" config-file="gitea-yaml.xml">org.jetbrains.plugins.yaml</depends>

  <!--
    VCS platform modules we use directly. Core modules up to 2026.2; from 2026.3 they live in the separate
    "Version Control" plugin (com.intellij.platform.vcs), and a v1 <depends> on Git4Idea doesn't make them visible.
    All four are public modules.
  -->
  <dependencies>
    <module name="intellij.platform.vcs"/>
    <module name="intellij.platform.vcs.impl"/>
    <module name="intellij.platform.vcs.dvcs"/>
    <module name="intellij.platform.vcs.dvcs.impl"/>
  </dependencies>

  <resource-bundle>messages.GiteaBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <!-- inside a Gitea view the Refresh shortcut (Cmd+R) only reloads it, not also Replace / Rerun -->
    <actionPromoter implementation="de.hendrikfrahmann.giteaplugin.ui.action.GiteaRefreshActionPromoter"/>
    <!-- Settings | Version Control | Gitea (accounts, connections), next to GitHub and GitLab (same parent and weight as
         theirs), with the child page "Settings" -->
    <projectConfigurable id="de.hendrikfrahmann.giteaplugin.settings"
                         parentId="project.propVCSSupport.Mappings"
                         groupWeight="-500"
                         displayName="Gitea"
                         instance="de.hendrikfrahmann.giteaplugin.settings.GiteaSettingsConfigurable"/>
    <projectConfigurable id="de.hendrikfrahmann.giteaplugin.settings.general"
                         parentId="de.hendrikfrahmann.giteaplugin.settings"
                         bundle="messages.GiteaBundle" key="settings.general.display.name"
                         instance="de.hendrikfrahmann.giteaplugin.settings.GiteaGeneralSettingsConfigurable"/>

    <toolWindow id="Gitea Pull Requests" icon="/icons/giteaToolWindow.svg" anchor="left" doNotActivateOnStart="true"
                factoryClass="de.hendrikfrahmann.giteaplugin.pullrequest.ui.toolwindow.GiteaToolWindowFactory"
                canCloseContents="true"/>

    <!-- Gitea Actions: own tool window (tree + job log), status bar summary -->
    <toolWindow id="Gitea Actions" icon="/icons/giteaToolWindow.svg" anchor="bottom" doNotActivateOnStart="true"
                factoryClass="de.hendrikfrahmann.giteaplugin.actions.ui.toolwindow.GiteaActionsToolWindowFactory"
                canCloseContents="true"/>
    <statusBarWidgetFactory id="Gitea.Actions" implementation="de.hendrikfrahmann.giteaplugin.actions.ui.GiteaActionsStatusBarWidgetFactory"
                            order="before Position"/>

    <!-- Review diff in editor tabs -->
    <virtualFileSystem key="giteapr" implementationClass="de.hendrikfrahmann.giteaplugin.pullrequest.file.GiteaVirtualFileSystem"/>
    <editorTabTitleProvider implementation="de.hendrikfrahmann.giteaplugin.pullrequest.file.GiteaPullRequestDiffFile$TitleProvider"/>
    <!-- PR timeline in editor tabs -->
    <fileEditorProvider implementation="de.hendrikfrahmann.giteaplugin.pullrequest.file.GiteaFileEditorProvider"/>
    <diff.DiffExtension implementation="de.hendrikfrahmann.giteaplugin.pullrequest.ui.diff.GiteaPullRequestDiffExtension"/>
    <!-- review threads in regular editors when the PR head branch is checked out -->
    <editorFactoryListener implementation="de.hendrikfrahmann.giteaplugin.pullrequest.review.GiteaEditorReviewController"/>
    <!-- comment editors: @user / #123 completion -->
    <completion.contributor language="any"
                            implementationClass="de.hendrikfrahmann.giteaplugin.pullrequest.ui.comment.GiteaCommentCompletionContributor"/>

    <notificationGroup id="Gitea" displayType="BALLOON" key="notification.group.gitea"/>
    <!-- Workflow files: local runs as run configurations, banner on files Gitea ignores, Gitea icon (also on `.gitea` folders); gutter icons in gitea-yaml.xml -->
    <configurationType implementation="de.hendrikfrahmann.giteaplugin.actions.workflow.run.GiteaWorkflowConfigurationType"/>
    <editorNotificationProvider implementation="de.hendrikfrahmann.giteaplugin.actions.workflow.GiteaInactiveWorkflowNotificationProvider"/>
    <fileIconProvider implementation="de.hendrikfrahmann.giteaplugin.actions.workflow.GiteaWorkflowFileIconProvider"/>
    <iconProvider implementation="de.hendrikfrahmann.giteaplugin.actions.workflow.GiteaDirectoryIconProvider"/>
    <notificationGroup id="Gitea Actions" displayType="TOOL_WINDOW" toolWindowId="Gitea Actions" key="notification.group.actions"/>

    <vcsAnnotationGutterActionProvider implementation="de.hendrikfrahmann.giteaplugin.ui.action.GiteaAnnotationGutterActionProvider"/>
    <vcsAnnotationGutterActionProvider
        implementation="de.hendrikfrahmann.giteaplugin.ui.action.GiteaPullRequestAnnotationGutterActionProvider"/>

    <openapi.vcs.ui.cloneDialog.VcsCloneDialogExtension
        implementation="de.hendrikfrahmann.giteaplugin.clone.GiteaCloneDialogExtension"/>

    <applicationSettings service="de.hendrikfrahmann.giteaplugin.authentication.accounts.GiteaPersistentAccounts"/>
    <applicationSettings service="de.hendrikfrahmann.giteaplugin.settings.GiteaSettings"/>
    <projectSettings service="de.hendrikfrahmann.giteaplugin.authentication.accounts.GiteaProjectDefaultAccountHolder"/>
    <projectSettings service="de.hendrikfrahmann.giteaplugin.repository.GiteaProjectSettings"/>
    <projectSettings service="de.hendrikfrahmann.giteaplugin.pullrequest.ui.filters.GiteaPullRequestsPersistentFiltersHistory"/>
    <projectSettings service="de.hendrikfrahmann.giteaplugin.pullrequest.data.GiteaPullRequestViewedState"/>
  </extensions>

  <extensions defaultExtensionNs="Git4Idea">
    <!-- current branch's PR in the branch widget -->
    <gitCurrentBranchPresenter implementation="de.hendrikfrahmann.giteaplugin.pullrequest.review.GiteaCurrentBranchPresenter"/>
    <GitHttpAuthDataProvider implementation="de.hendrikfrahmann.giteaplugin.git.GiteaHttpAuthDataProvider"/>
    <GitHttpAuthDataProvider implementation="de.hendrikfrahmann.giteaplugin.git.GiteaInteractiveHttpAuthDataProvider"/>
  </extensions>

  <actions>
    <action id="Gitea.Open.Settings" class="de.hendrikfrahmann.giteaplugin.settings.GiteaOpenSettingsAction"
            icon="/icons/gitea.svg"/>
    <action id="Gitea.Open.GeneralSettings" class="de.hendrikfrahmann.giteaplugin.settings.GiteaOpenGeneralSettingsAction"
            icon="AllIcons.General.Settings"/>
    <action id="Gitea.Clone" class="de.hendrikfrahmann.giteaplugin.clone.GiteaCloneAction" icon="/icons/gitea.svg"/>
    <action id="Gitea.Share" class="de.hendrikfrahmann.giteaplugin.share.GiteaShareProjectAction" icon="/icons/gitea.svg">
      <add-to-group group-id="Vcs.Import"/>
      <add-to-group group-id="Vcs.ToolbarWidget.ShareProject"/>
      <override-text place="Vcs.Toolbar.Widget"/>
    </action>

    <!-- Open In → Gitea and Copy Path/Reference → Gitea; same places and overrides as the GitLab plugin -->
    <group id="Gitea.Open.In.Browser" class="de.hendrikfrahmann.giteaplugin.ui.action.GiteaOpenInBrowserActionGroup"
           icon="/icons/gitea.svg">
      <override-text place="EditorTabPopup"/>
      <override-text place="ProjectViewPopup" use-text-of-place="EditorTabPopup"/>
      <override-text place="EditorPopup" use-text-of-place="EditorTabPopup"/>
      <override-text place="BookmarksPopup" use-text-of-place="EditorTabPopup"/>
      <add-to-group group-id="Git.Hosting.Open.In.Browser.Group"/>
    </group>
    <group id="Gitea.Copy.Link" class="de.hendrikfrahmann.giteaplugin.ui.action.GiteaCopyLinkActionGroup" icon="/icons/gitea.svg">
      <override-text place="CopyReferencePopup"/>
      <add-to-group group-id="Git.Hosting.Copy.Link.Group"/>
    </group>

    <!-- Pull requests -->
    <action id="Gitea.PullRequest.Show.List" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaShowPullRequestsAction"
            icon="/icons/gitea.svg"/>
    <action id="Gitea.Repositories.Show" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaShowRepositoriesAction"/>
    <action id="Gitea.PullRequest.Checkout" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaCheckoutPullRequestAction"
            icon="AllIcons.Actions.CheckOut"/>
    <action id="Gitea.PullRequest.Show" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaShowPullRequestAction"/>
    <action id="Gitea.PullRequest.Create" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaCreatePullRequestAction"
            icon="/icons/gitea.svg"/>
    <action id="Gitea.PullRequest.ShowActions" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaPullRequestShowActionsAction"
            icon="/icons/giteaToolWindow.svg"/>
    <action id="Gitea.PullRequest.Open.In.Browser"
            class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaOpenPullRequestInBrowserAction"/>
    <action id="Gitea.PullRequest.Copy.Link" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaCopyPullRequestLinkAction"/>
    <action id="Gitea.PullRequest.List.Refresh" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaRefreshPullRequestsAction"
            use-shortcut-of="Refresh" icon="AllIcons.Actions.Refresh"/>
    <action id="Gitea.PullRequest.Refresh" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaRefreshPullRequestAction"
            use-shortcut-of="Refresh" icon="AllIcons.Actions.Refresh"/>
    <action id="Gitea.PullRequest.Changes.Show.Diff" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaShowPullRequestDiffAction"
            use-shortcut-of="Diff.ShowDiff" icon="AllIcons.Actions.Diff"/>
    <action id="Gitea.PullRequest.Changes.Mark.Viewed" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaMarkViewedAction"/>
    <action id="Gitea.PullRequest.Changes.Mark.Not.Viewed" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaMarkNotViewedAction"/>
    <action id="Gitea.PullRequest.Review.Submit" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaSubmitReviewAction"
            icon="/icons/submitReview.svg"/>
    <action id="Gitea.PullRequest.Diff.Next.Comment" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaDiffNextCommentAction"
            icon="AllIcons.Actions.MoveDown" use-shortcut-of="NextOccurence"/>
    <action id="Gitea.PullRequest.Diff.Previous.Comment" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaDiffPreviousCommentAction"
            icon="AllIcons.Actions.MoveUp" use-shortcut-of="PreviousOccurence"/>
    <group id="Gitea.PullRequest.Diff.Discussions.View.Options" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaDiffDiscussionsToggleAction"
           icon="AllIcons.Actions.Show" popup="true"/>
    <action id="Gitea.PullRequest.Review.Mode.Toggle" class="de.hendrikfrahmann.giteaplugin.pullrequest.review.GiteaToggleEditorReviewModeAction"/>
    <action id="Gitea.PullRequest.Edit.Reviewers" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaEditReviewersAction"/>
    <action id="Gitea.PullRequest.Edit.Assignees" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaEditAssigneesAction"/>
    <action id="Gitea.PullRequest.Edit.Labels" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaEditLabelsAction"/>
    <action id="Gitea.PullRequest.Edit.Milestone" class="de.hendrikfrahmann.giteaplugin.pullrequest.action.GiteaEditMilestoneAction"/>
    <group id="Gitea.PullRequest.Edit.Group">
      <reference ref="Gitea.PullRequest.Edit.Reviewers"/>
      <reference ref="Gitea.PullRequest.Edit.Assignees"/>
      <reference ref="Gitea.PullRequest.Edit.Labels"/>
      <reference ref="Gitea.PullRequest.Edit.Milestone"/>
    </group>
    <group id="Gitea.PullRequest.Details.Popup">
      <reference ref="Gitea.PullRequest.Checkout"/>
      <separator/>
      <reference ref="Gitea.PullRequest.Edit.Group"/>
      <separator/>
      <reference ref="Gitea.PullRequest.ShowActions"/>
      <reference ref="Gitea.PullRequest.Open.In.Browser"/>
      <reference ref="Gitea.PullRequest.Copy.Link"/>
      <separator/>
      <reference ref="Gitea.PullRequest.Refresh"/>
    </group>
    <action id="Gitea.PullRequest.Timeline.Show.Events" class="de.hendrikfrahmann.giteaplugin.pullrequest.ui.timeline.GiteaTimelineShowEventsAction"/>
    <group id="Gitea.PullRequest.Timeline.Popup">
      <reference ref="Gitea.PullRequest.Edit.Group"/>
      <separator/>
      <reference ref="Gitea.PullRequest.ShowActions"/>
      <reference ref="Gitea.PullRequest.Open.In.Browser"/>
      <reference ref="Gitea.PullRequest.Copy.Link"/>
      <separator/>
      <reference ref="Gitea.PullRequest.Refresh"/>
      <reference ref="Gitea.PullRequest.Timeline.Show.Events"/>
    </group>
    <group id="Gitea.PullRequest.Timeline.Error.Popup">
      <reference ref="Gitea.PullRequest.Refresh"/>
    </group>
    <group id="Gitea.PullRequest.Changes.Popup">
      <reference ref="Gitea.PullRequest.Changes.Show.Diff"/>
      <separator/>
      <reference ref="Gitea.PullRequest.Changes.Mark.Viewed"/>
      <reference ref="Gitea.PullRequest.Changes.Mark.Not.Viewed"/>
    </group>
    <group id="Gitea.PullRequest.List.Actions">
      <reference ref="Gitea.PullRequest.Show"/>
      <reference ref="Gitea.PullRequest.Checkout"/>
      <reference ref="Gitea.PullRequest.ShowActions"/>
      <reference ref="Gitea.PullRequest.Open.In.Browser"/>
      <reference ref="Gitea.PullRequest.Copy.Link"/>
      <separator/>
      <reference ref="Gitea.PullRequest.List.Refresh"/>
    </group>

    <!-- Current branch: branch popup, like GitHub's/GitLab's -->
    <action id="Gitea.PullRequest.Branch.Show" class="de.hendrikfrahmann.giteaplugin.pullrequest.review.GiteaShowCurrentBranchPullRequestAction"
            icon="/icons/gitea.svg"/>
    <action id="Gitea.PullRequest.Branch.Update" class="de.hendrikfrahmann.giteaplugin.pullrequest.review.GiteaUpdateCurrentBranchAction"
            icon="AllIcons.General.Warning"/>
    <group id="Gitea.PullRequest.Branch.Popup.Actions" class="de.hendrikfrahmann.giteaplugin.pullrequest.review.GiteaCurrentBranchActionGroup">
      <separator/>
      <reference ref="Gitea.PullRequest.Branch.Show"/>
      <reference ref="Gitea.PullRequest.Review.Submit"/>
      <reference ref="Gitea.PullRequest.Branch.Update"/>
      <reference ref="Gitea.PullRequest.Review.Mode.Toggle"/>
      <add-to-group group-id="Git.Experimental.Branch.Popup.Actions"/>
    </group>

    <!-- Gitea Actions -->
    <action id="Gitea.Actions.Show" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaShowActionsAction"/>
    <action id="Gitea.Actions.Refresh" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsRefreshAction"
            use-shortcut-of="Refresh" icon="AllIcons.Actions.Refresh"/>
    <action id="Gitea.Actions.Open.Log" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsOpenLogAction"
            icon="AllIcons.Debugger.Console"/>
    <action id="Gitea.Actions.Open.PullRequest" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsOpenPullRequestAction"
            icon="AllIcons.Vcs.Merge"/>
    <action id="Gitea.Actions.Run.Rerun" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsRerunAction"
            icon="AllIcons.Actions.Restart"/>
    <action id="Gitea.Actions.Run.Rerun.Failed" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsRerunFailedAction"
            icon="AllIcons.RunConfigurations.RerunFailedTests"/>
    <action id="Gitea.Actions.Job.Rerun" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsRerunJobAction"
            icon="AllIcons.Actions.Restart"/>
    <action id="Gitea.Actions.Run.Cancel" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsCancelAction"
            icon="AllIcons.Actions.Suspend"/>
    <action id="Gitea.Actions.Run.ForceCancel" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsForceCancelAction"/>
    <action id="Gitea.Actions.Run.Approve" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsApproveAction"
            icon="AllIcons.Actions.Checked"/>
    <action id="Gitea.Actions.Run.Delete" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsDeleteRunAction"
            icon="AllIcons.Actions.GC"/>
    <action id="Gitea.Actions.Workflow.Dispatch" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsDispatchAction"
            icon="AllIcons.Actions.Execute"/>
    <action id="Gitea.Actions.Open.Workflow.File" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsOpenWorkflowFileAction"
            icon="AllIcons.Actions.EditSource"/>
    <action id="Gitea.Actions.Artifact.Download" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsDownloadArtifactAction"
            icon="AllIcons.Actions.Download"/>
    <action id="Gitea.Actions.Run.Download.Logs" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsDownloadLogsAction"/>
    <action id="Gitea.Actions.Open.In.Browser" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsOpenInBrowserAction"
            icon="AllIcons.General.Web"/>
    <action id="Gitea.Actions.Copy.Link" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsCopyLinkAction"/>
    <action id="Gitea.Workflow.Run.Remote" class="de.hendrikfrahmann.giteaplugin.actions.workflow.GiteaRunWorkflowRemotelyAction"
            icon="/icons/gitea.svg"/>
    <action id="Gitea.Actions.Secrets" class="de.hendrikfrahmann.giteaplugin.actions.action.GiteaActionsSecretsAction"
            icon="AllIcons.General.Settings"/>
    <group id="Gitea.Actions.Toolbar">
      <reference ref="Gitea.Actions.Refresh"/>
      <reference ref="Gitea.Actions.Workflow.Dispatch"/>
      <separator/>
      <reference ref="ExpandAll"/>
      <reference ref="CollapseAll"/>
      <separator/>
      <reference ref="Gitea.Actions.Secrets"/>
    </group>
    <group id="Gitea.Actions.Tree.Popup">
      <reference ref="Gitea.Actions.Open.Log"/>
      <reference ref="Gitea.Actions.Open.PullRequest"/>
      <reference ref="Gitea.Actions.Open.Workflow.File"/>
      <separator/>
      <reference ref="Gitea.Actions.Run.Rerun"/>
      <reference ref="Gitea.Actions.Run.Rerun.Failed"/>
      <reference ref="Gitea.Actions.Job.Rerun"/>
      <reference ref="Gitea.Actions.Run.Cancel"/>
      <reference ref="Gitea.Actions.Run.ForceCancel"/>
      <reference ref="Gitea.Actions.Run.Approve"/>
      <reference ref="Gitea.Actions.Workflow.Dispatch"/>
      <separator/>
      <reference ref="Gitea.Actions.Artifact.Download"/>
      <reference ref="Gitea.Actions.Run.Download.Logs"/>
      <separator/>
      <reference ref="Gitea.Actions.Open.In.Browser"/>
      <reference ref="Gitea.Actions.Copy.Link"/>
      <separator/>
      <reference ref="Gitea.Actions.Run.Delete"/>
      <separator/>
      <reference ref="Gitea.Actions.Refresh"/>
    </group>

    <!-- Git | Gitea, like Git | GitHub and Git | GitLab -->
    <group id="Gitea.Main.Group" popup="true" icon="/icons/gitea.svg">
      <reference ref="Gitea.PullRequest.Show.List"/>
      <reference ref="Gitea.PullRequest.Create"/>
      <reference ref="Gitea.PullRequest.Review.Mode.Toggle"/>
      <reference ref="Gitea.Actions.Show"/>
      <reference ref="Gitea.Repositories.Show"/>
      <separator/>
      <reference ref="Gitea.Share"/>
      <reference ref="Gitea.Clone"/>
      <separator/>
      <reference ref="Gitea.Open.Settings"/>
      <add-to-group group-id="Git.MainMenu" relative-to-action="Git.Configure.Remotes" anchor="before"/>
    </group>
  </actions>
</idea-plugin>
